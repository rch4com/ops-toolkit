<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:MIPLabelCustomCheck.Explorer.ViewModels">
    <!-- Defaults also permit the designer to render without application startup. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#EEF0F9" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F8F9FE" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#E4E7F5" />
    <SolidColorBrush x:Key="TextBrush" Color="#292B31" />
    <SolidColorBrush x:Key="MutedBrush" Color="#595D6C" />
    <SolidColorBrush x:Key="BorderBrush" Color="#75798C" />
    <SolidColorBrush x:Key="AccentBrush" Color="#796CBF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#5D5294" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#E7E5FE" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#292B31" />
    <SolidColorBrush x:Key="PressedBrush" Color="#D2CEFD" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#A1263D" />
    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#FBE8ED" />

    <Style x:Key="KeyboardFocus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="1,1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Outline" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="Background" Value="{DynamicResource SelectionBrush}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Outline" Property="Background" Value="{DynamicResource PressedBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter TargetName="Outline" Property="Background" Value="{DynamicResource SubtleBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource PressedBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="32" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
    </Style>
    <Style TargetType="ComboBox">
        <!-- Keep the native drop-down template and keyboard/disabled behavior. -->
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,8" />
    </Style>
    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="ListViewItem">
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    </Style>
    <Style x:Key="StateText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:CheckState.Completed}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:CheckState.Running}"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:CheckState.Failed}"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" /></DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
